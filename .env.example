# Kopiere diese Datei nach ".env" und fülle die Werte aus.

# --- Admin-Login ---
# Beim Login ins Feld "E-Mail" einfach "admin" eingeben.
# Wird das Passwort geändert, werden beim nächsten Start alle Admin-Geräte ausgeloggt.
ADMIN_PASSWORD=bitte-aendern
# ADMIN_USERNAME=admin

# --- Öffentliche Adresse der App (für die Links in den Mails) ---
APP_URL=https://jfc.example.ch

# --- Mailversand (SMTP) ---
SMTP_HOST=mail.example.ch
SMTP_PORT=587
SMTP_USER=noreply@example.ch
SMTP_PASS=
MAIL_FROM="Jesus First Camp <noreply@example.ch>"
# SMTP_SECURE=true          # bei Port 465 automatisch, sonst STARTTLS

# --- Optional ---
# EMAIL_VERIFICATION=off    # Notfall: Konten ohne Mail-Bestätigung sofort aktiv
# REGISTRATION_CODE=        # Camp-Code, ohne den man sich nicht registrieren kann
# PORT=3000
# DATA_DIR=./data           # bei Docker nicht ändern (Volume /data)
